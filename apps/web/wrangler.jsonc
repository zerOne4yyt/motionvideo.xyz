{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "motion-library-zerone",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/personal-server.ts",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/*"],
  },
  "observability": {
    "enabled": false,
  },
  "vars": {
    "BETTER_AUTH_URL": "https://motionvideo.xyz",
    "EMAIL_FROM": "",
    "ADMIN_EMAILS": "",
    "DODO_PAYMENTS_ENVIRONMENT": "test_mode",
    "UPLOADS_PUBLIC_URL": "",
  },
}
